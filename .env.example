DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# En WSL: la base SQLite debe estar en el filesystem nativo de Linux,
# nunca en /mnt/c (falla con "disk I/O error" al escribir).
CTF_DB_PATH=/home/TU_USUARIO/ctf-data/db.sqlite3

DOCKER_SOCKET_PATH=/var/run/docker.sock

# Los retos ya no son una imagen fija: se eligen del catalogo en
# ctf/challenges.py (los 10 de OWASP Top 10). Construir la base y luego
# cada reto, ver README paso 7.

# Shell de la consola. Vacío = automático: usa bash si la imagen lo trae
# (activa `bracketed paste`) y sh si no. Solo para forzar uno concreto.
CTF_CONSOLE_SHELL=
CTF_MEMORY_LIMIT_MB=256
CTF_NANO_CPUS=500000000
CTF_PIDS_LIMIT=64
CTF_INACTIVITY_TIMEOUT_SECONDS=900

# Vida máxima absoluta de una instancia, sin importar su actividad (evita
# que un bucle con salida periódica la mantenga viva para siempre).
CTF_MAX_LIFETIME_SECONDS=7200
